+
+void HyprlandIpc::refreshAfterReconnect() {
+	if (!this->valid) return;
+	if (this->requestingMonitors || this->requestingWorkspaces || this->requestingToplevels) {
+		this->refreshTimer.start(RECONNECT_DELAY_MS);
+		return;
+	}
+	this->refreshMonitors(true);
+	this->refreshWorkspaces(true);
+	this->refreshToplevels();
 }
 
