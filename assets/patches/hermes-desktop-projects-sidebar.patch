+import { useStore } from '@nanostores/react'
+import type { ReactNode } from 'react'
+import { useId, useRef, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle
+} from '@/components/ui/dialog'
+import { DisclosureCaret } from '@/components/ui/disclosure-caret'
+import { Input } from '@/components/ui/input'
+import { Tip } from '@/components/ui/tooltip'
+import { useI18n } from '@/i18n'
+import type { SidebarGroup, SidebarGroupCommand } from '@/lib/project-sidebar-wire'
+import type { ProjectSidebarSnapshot } from '@/store/project-tree'
+import {
+  $sidebarGroupWrites,
+  captureSidebarGroupOwner,
+  projectSidebarScopeKey,
+  refreshProjectTree,
+  writeSidebarGroup
+} from '@/store/projects'
+
+import {
+  SIDEBAR_LEAD_ICON_SIZE,
+  SidebarRowBody,
+  SidebarRowLabel,
+  SidebarRowLead,
+  SidebarRowNest,
+  SidebarRowShell
+} from '../chrome'
+import { mergeVisibleReorder } from '../order'
+
+import { orderProjectsByIds, sortProjectsForOverview } from './model'
+import type { SidebarProjectTree } from './workspace-groups'
+
+type GroupOwner = NonNullable<ReturnType<typeof captureSidebarGroupOwner>>
+interface GroupTarget {
+  owner: GroupOwner
+  id: string
+  name: string
+}
+
+type FolderDialog = { kind: 'create'; owner: GroupOwner } | (GroupTarget & { kind: 'assign' | 'delete' })
+
+export type CaptureProjectFolderAction = (project: SidebarProjectTree) => (() => void) | null
+
+export function useProjectFolders(scope: string, snapshot: ProjectSidebarSnapshot | null) {
+  const writes = useStore($sidebarGroupWrites)
+  const [collapsed, setCollapsed] = useState<Record<string, Set<string>>>({})
+  const [view, setView] = useState<{ scope: string; open: boolean; dialog?: FolderDialog; error?: string }>({
+    scope,
+    open: false
+  })
+  if (view.scope !== scope) {
+    setView({ scope, open: false })
+  }
+
+  const current = view.scope === scope ? view : { scope, open: false }
+  const canWrite = Boolean(snapshot?.groups && !snapshot.stale && !writes[scope])
+  const groups = snapshot?.groups ?? []
+  const memberships = new Map(snapshot?.memberships.map(row => [row.project_id, row.group_id]))
+  const namedIds = new Set(snapshot?.namedProjectIds)
+  const groupOf = (project: SidebarProjectTree) =>
+    !project.connectionId && !project.isAuto && !project.isNoProject && namedIds.has(project.id)
+      ? memberships.get(project.id)
+      : undefined
+  const focus = (key: string, fallback = 'new') => {
+    requestAnimationFrame(() => {
+      if (projectSidebarScopeKey() !== scope || document.activeElement !== document.body) {
+        return
+      }
+
+      const controls = [...document.querySelectorAll<HTMLElement>('[data-project-folder-focus]')]
+        .filter(control => !control.closest('[hidden], [inert]'))
+
+      const target =
+        controls.find(el => el.dataset.projectFolderFocus === key) ??
+        controls.find(el => el.dataset.projectFolderFocus === fallback) ??
+        controls.find(el => el.dataset.projectFolderFocus === 'new') ??
+        controls.find(el => el.dataset.projectFolderFocus === 'archives')
+
+      target?.focus()
+    })
+  }
+  const captureAssignment: CaptureProjectFolderAction = project => {
+    if (
+      !canWrite ||
+      !groups.length ||
+      !namedIds.has(project.id) ||
+      project.isAuto ||
+      project.isNoProject ||
+      project.archived ||
+      project.connectionId ||
+      project.mergeKey
+    ) {
+      return null
+    }
+
+    const owner = captureSidebarGroupOwner()
+
+    if (!owner) {
+      return null
+    }
+
+    const dialog: FolderDialog = { kind: 'assign', owner, id: project.id, name: project.label }
+
+    return () => {
+      if (projectSidebarScopeKey() === scope) {
+        setView(value => ({ ...value, dialog, error: undefined }))
+      }
+    }
+  }
+  const showDialog = (group?: SidebarGroup) => {
+    const owner = captureSidebarGroupOwner()
+
+    if (owner) {
+      const dialog: FolderDialog = group
+        ? { kind: 'delete', owner, id: group.id, name: group.name }
+        : { kind: 'create', owner }
+      setView(value => ({ ...value, dialog, error: undefined }))
+    }
+  }
+  const closeDialog = (error?: string) => setView(value => ({ ...value, dialog: undefined, error }))
+
+  return {
+    scope,
+    groups,
+    groupOf,
+    canWrite,
+    captureAssignment,
+    showDialog,
+    closeDialog,
+    focus,
+    current,
+    memberships,
+    unknown: writes[scope]?.unknown === true,
+    openDrawer: () => {
+      setView(value => ({ ...value, open: !current.open }))
+      if (!current.open) {
+        void refreshProjectTree()
+      }
+    },
+    isExpanded: (id: string) => !collapsed[scope]?.has(id),
+    toggleGroup: (id: string) =>
+      setCollapsed(value => {
+        const next = new Set(value[scope])
+        if (!next.delete(id)) {
+          next.add(id)
+        }
+
+        return { ...value, [scope]: next }
+      })
+  }
+}
+
+export type ProjectFoldersView = ReturnType<typeof useProjectFolders>
+
+export function NewProjectFolderButton({ view, available }: { view: ProjectFoldersView; available: boolean }) {
+  const { t } = useI18n()
+  const label = t.sidebar.projects.projectFolders.create
+
+  if (!available) {
+    return null
+  }
+
+  return (
+    <Tip label={label}>
+      <Button
+        aria-disabled={!view.canWrite}
+        aria-label={label}
+        data-project-folder-focus="new"
+        onClick={() => view.canWrite && view.showDialog()}
+        size="icon-xs"
+        variant="ghost"
+      >
+        <Codicon name="new-folder" size="0.75rem" />
+      </Button>
+    </Tip>
+  )
+}
+
+function DisclosureRow({
+  actions,
+  controls,
+  focusKey,
+  icon,
+  label,
+  open,
+  toggle
+}: {
+  actions?: ReactNode
+  controls: string
+  focusKey?: string
+  icon: 'archive' | 'folder' | 'folder-opened'
+  label: string
+  open: boolean
+  toggle: () => void
+}) {
+  return (
+    <SidebarRowShell actions={actions}>
+      <SidebarRowBody
+        aria-controls={controls}
+        aria-expanded={open}
+        className="min-w-0 hover:text-foreground"
+        data-project-folder-focus={focusKey}
+        onClick={toggle}
+        type="button"
+      >
+        <SidebarRowLead>
+          <Codicon name={icon} size={SIDEBAR_LEAD_ICON_SIZE} />
+        </SidebarRowLead>
+        <SidebarRowLabel className="flex-1">{label}</SidebarRowLabel>
+        <DisclosureCaret className="shrink-0 text-(--ui-text-tertiary)" open={open} />
+      </SidebarRowBody>
+    </SidebarRowShell>
+  )
+}
+
+export function ProjectFolderSection({
+  group,
+  count,
+  view,
+  children
+}: {
+  group: SidebarGroup
+  count: number
+  view: ProjectFoldersView
+  children: ReactNode
+}) {
+  const { t } = useI18n()
+  const p = t.sidebar.projects.projectFolders
+  const bodyId = useId()
+  const expanded = view.isExpanded(group.id)
+
+  return (
+    <section aria-label={group.name}>
+      <DisclosureRow
+        actions={
+          <>
+            <span aria-label={p.count(count)} className="text-xs text-(--ui-text-tertiary)">
+              {count}
+            </span>
+            <Button
+              aria-disabled={!view.canWrite}
+              aria-label={p.delete}
+              data-project-folder-focus={`delete:${group.id}`}
+              onClick={() => view.canWrite && view.showDialog(group)}
+              size="icon-xs"
+              variant="ghost"
+            >
+              <Codicon name="trash" size="0.75rem" />
+            </Button>
+          </>
+        }
+        controls={bodyId}
+        focusKey={`group:${group.id}`}
+        icon={expanded ? 'folder-opened' : 'folder'}
+        label={group.name}
+        open={expanded}
+        toggle={() => view.toggleGroup(group.id)}
+      />
+      <div hidden={!expanded} id={bodyId}>
+        {expanded && <SidebarRowNest>{children}</SidebarRowNest>}
+      </div>
+    </section>
+  )
+}
+
+const compare = (a: string, b: string) => (a === b ? 0 : a < b ? -1 : 1)
+
+export function ArchivedProjectsDrawer({
+  open,
+  toggle,
+  snapshot
+}: {
+  open: boolean
+  toggle: () => void
+  snapshot: ProjectSidebarSnapshot | null
+}) {
+  const { t } = useI18n()
+  const p = t.sidebar.projects.archivedProjects
+  const id = useId()
+  const slices = snapshot?.archives
+  const healthy = Array.isArray(slices)
+    ? slices.filter(slice => slice.status === 'ok' || slice.status === 'missing_store')
+    : []
+  const complete = Array.isArray(slices) && healthy.length === slices.length
+  const records = healthy
+    .flatMap(slice => slice.archived_projects.map(row => ({ ...row, profile: slice.profile })))
+    .sort(
+      (a, b) =>
+        compare(a.profile, b.profile) ||
+        compare(a.name.normalize('NFC'), b.name.normalize('NFC')) ||
+        compare(a.id, b.id)
+    )
+  let status: string | undefined
+
+  if (!snapshot) {
+    status = p.loading
+  } else if (complete) {
+    status = records.length ? undefined : p.empty
+  } else if (healthy.length) {
+    status = p.partial
+  } else if (
+    slices === 'unsupported' ||
+    (Array.isArray(slices) && slices.every(slice => slice.status === 'unsupported'))
+  ) {
+    status = p.unsupported
+  } else {
+    status = p.unavailable
+  }
+
+  return (
+    <section aria-label={p.title}>
+      <DisclosureRow
+        controls={id}
+        focusKey="archives"
+        icon="archive"
+        label={open && complete ? p.count(records.length) : p.title}
+        open={open}
+        toggle={toggle}
+      />
+      <div hidden={!open} id={id}>
+        {open && (
+          <SidebarRowNest>
+            {status && (
+              <p className="px-2 py-1 text-xs text-(--ui-text-secondary)" role="status">
+                {status}
+              </p>
+            )}
+            {records.length > 0 && (
+              <ul>
+                {records.map(row => (
+                  <li
+                    className="flex min-w-0 items-baseline justify-between gap-2 px-2 py-1 text-xs"
+                    key={JSON.stringify([snapshot?.connectionId, row.profile, row.id])}
+                  >
+                    <span className="min-w-0 break-words">{row.name}</span>
+                    {!snapshot?.profile && (
+                      <span className="min-w-0 break-words text-(--ui-text-tertiary)">{row.profile}</span>
+                    )}
+                  </li>
+                ))}
+              </ul>
+            )}
+          </SidebarRowNest>
+        )}
+      </div>
+    </section>
+  )
+}
+
+export function ProjectFoldersStatus({
+  snapshot,
+  view
+}: {
+  snapshot: ProjectSidebarSnapshot | null
+  view: ProjectFoldersView
+}) {
+  const { t } = useI18n()
+  const p = t.sidebar.projects.projectFolders
+  const failed =
+    Array.isArray(snapshot?.archives) && snapshot.archives.some(slice => slice.tree_status === 'unavailable')
+  const treeError =
+    snapshot?.stale && snapshot.tree.length ? p.stale : snapshot?.stale || failed ? p.unavailable : undefined
+  const message = view.unknown ? p.unknown : (view.current.error ?? treeError)
+
+  return message ? (
+    <div className="px-2 py-1 text-xs text-(--ui-text-secondary)">
+      <p role="status">{message}</p>
+      {(view.unknown || treeError) && (
+        <Button onClick={() => void refreshProjectTree()} size="inline" variant="text">
+          {p.refresh}
+        </Button>
+      )}
+    </div>
+  ) : null
+}
+
+export function ProjectFolderDialog({ view }: { view: ProjectFoldersView }) {
+  const dialog = view.current.dialog
+
+  return dialog ? <FolderDialogForm dialog={dialog} view={view} /> : null
+}
+
+function FolderDialogForm({ dialog, view }: { dialog: FolderDialog; view: ProjectFoldersView }) {
+  const { t } = useI18n()
+  const p = t.sidebar.projects.projectFolders
+  const [name, setName] = useState('')
+  const [selected, setSelected] = useState(dialog.kind === 'assign' ? (view.memberships.get(dialog.id) ?? '') : '')
+  const [pending, setPending] = useState(false)
+  const field = useId()
+  const returnFocus = useRef<{ key: string; fallback?: string } | null>(null)
+  const initiate =
+    dialog.kind === 'create' ? 'new' : dialog.kind === 'assign' ? `project:${dialog.id}` : `delete:${dialog.id}`
+  const assigning = dialog.kind === 'assign'
+  const creating = dialog.kind === 'create'
+  const normalized = name.normalize('NFC').trim()
+  const validName = normalized.length > 0 && [...normalized].length <= 80 && !/[\p{Cc}\p{Cs}]/u.test(name)
+  const dismiss = (key = initiate, fallback?: string, error?: string) => {
+    returnFocus.current = { key, fallback }
+    view.closeDialog(error)
+  }
+
+  const save = async (form: HTMLFormElement) => {
+    if (!view.canWrite || pending || (creating && !validName)) {
+      return
+    }
+
+    setPending(true)
+    const command: SidebarGroupCommand = creating
+      ? { action: 'create', name }
+      : assigning
+        ? { action: 'assign', project_id: dialog.id, group_id: selected || null }
+        : { action: 'delete', group_id: dialog.id }
+    const result = await writeSidebarGroup(dialog.owner, command)
+
+    if (!form.isConnected) {
+      return
+    }
+
+    if (result.status === 'departed') {
+      view.closeDialog()
+
+      return
+    }
+
+    const error =
+      result.status === 'refused' ? (result.reason === 'duplicate_name' ? p.duplicate : p.failed) : undefined
+
+    if (result.status !== 'saved' || result.refreshFailed) {
+      dismiss(initiate, undefined, error)
+    } else if (creating && result.groupId) {
+      dismiss(`group:${result.groupId}`)
+    } else if (assigning) {
+      dismiss(initiate, result.groupId ? `group:${result.groupId}` : 'new')
+    } else {
+      dismiss('new')
+    }
+  }
+
+  return (
+    <Dialog
+      onOpenChange={open => {
+        if (!open && !pending) {
+          dismiss()
+        }
+      }}
+      open
+    >
+      <DialogContent
+        onCloseAutoFocus={event => {
+          event.preventDefault()
+          const target = returnFocus.current
+          if (target) {
+            view.focus(target.key, target.fallback)
+          }
+        }}
+      >
+        <DialogHeader>
+          <DialogTitle>{creating ? p.create : assigning ? p.assign : p.deleteTitle(dialog.name)}</DialogTitle>
+          <DialogDescription>{creating ? p.nameHelp : assigning ? dialog.name : p.deleteHelp}</DialogDescription>
+        </DialogHeader>
+        <form
+          onSubmit={event => {
+            event.preventDefault()
+            void save(event.currentTarget)
+          }}
+        >
+          {creating && (
+            <div className="mb-4 grid gap-2">
+              <label htmlFor={field}>{p.name}</label>
+              <Input autoFocus id={field} onChange={event => setName(event.currentTarget.value)} value={name} />
+            </div>
+          )}
+          {assigning && (
