diff --git a/apps/desktop/src/store/legacy-resume-continuation.ts b/apps/desktop/src/store/legacy-resume-continuation.ts
new file mode 100644
index 0000000..6c8aabd
--- /dev/null
+++ b/apps/desktop/src/store/legacy-resume-continuation.ts
@@ -0,0 +1,89 @@
+import { $connectionsRegistry } from './connection-registry-state'
+import type { SessionOwnerRoute } from './session-request-router'
+import type { AcceptedSessionIdentity } from './session-states'
+
+// Capture the legacy wire, after any shared-primary profile rewrite. A routed
+// request alone doesn't say which profile the final frame actually named.
+const wireRequests = new WeakMap<object, { requested: string; profile: string }>()
+export function recordLegacyResumeWire(reply: unknown, params: Record<string, unknown>): void {
+  if (reply && typeof reply === 'object' && typeof params.session_id === 'string' && typeof params.profile === 'string') {
+    wireRequests.set(reply, { requested: params.session_id, profile: params.profile })
+  }
+}
+
+class LegacyContinuation implements AcceptedSessionIdentity {
+  constructor(readonly requested: string, readonly storedSessionId: string,
+    readonly runtimeSessionId: string, readonly signal: AbortSignal, readonly profile: string) {}
+}
+
+interface Candidate {
+  owner: SessionOwnerRoute
+  signal: AbortSignal
+  requested: string
+  tip: string
+  runtime: string
+}
+const candidates = new WeakMap<object, Candidate>()
+
+export function recordLegacyContinuation(requested: unknown, reply: unknown, owner: SessionOwnerRoute, signal: AbortSignal): void {
+  if (signal.aborted || typeof requested !== 'string' || !requested || !reply || typeof reply !== 'object') { return }
+  const wire = wireRequests.get(reply)
+  if (!wire || wire.requested !== requested || wire.profile !== (owner.targetProfile ?? owner.profile)) { return }
+  const { session_id, session_key, resumed } = reply as Record<string, unknown>
+  if (typeof session_id !== 'string' || !session_id || typeof resumed !== 'string' || !resumed ||
+    resumed === requested || resumed !== session_key) { return }
+  candidates.set(reply, { requested, tip: resumed, runtime: session_id, owner: { ...owner }, signal })
+}
+
+interface Descendant {
+  requested_session_id?: unknown
+  session_id?: unknown
+  path?: unknown
+}
+
+export async function legacyContinuationFor(reply: object, requested: string, owner: SessionOwnerRoute, signal: AbortSignal,
+  read: (id: string, owner: SessionOwnerRoute) => Promise<Descendant>) {
+  const candidate = candidates.get(reply)
+  const target = owner.targetProfile ?? owner.profile
+  if (!candidate || signal.aborted || candidate.signal !== signal || candidate.requested !== requested ||
+    candidate.owner.connectionId !== owner.connectionId || candidate.owner.profile !== owner.profile ||
+    (candidate.owner.targetProfile ?? candidate.owner.profile) !== target || !target || !owner.connectionId.trim()) { return null }
+  const source = $connectionsRegistry.get()?.connections.find(entry => entry.id === owner.connectionId)
+  // An isolated SSH descriptor translates a self-profile HTTP filter to its
+  // configured remote alias. Never compare that DB with a different WS scope.
+  if (!source || (source.kind === 'ssh' && source.remoteProfile && target === owner.profile && source.remoteProfile !== target)) {
+    return null
+  }
+  const result = await read(requested, owner).catch(() => null)
+  if (signal.aborted || !result || result.requested_session_id !== requested || result.session_id !== candidate.tip ||
+    !Array.isArray(result.path) || result.path.length < 2 || result.path[0] !== requested || result.path.at(-1) !== candidate.tip ||
+    !result.path.every(id => typeof id === 'string' && id.length > 0)) { return null }
+  return new LegacyContinuation(requested, candidate.tip, candidate.runtime, signal, target)
+}
+
+// Profile routing can still change during a turn lease. Carry this check
+// through parameter spreads to the synchronous send; symbols are not JSON.
+const dispatchGuard = Symbol('verified legacy continuation')
+type GuardedParams = Record<string, unknown> & {
+  [dispatchGuard]?: (wire: Record<string, unknown>, legacy: boolean) => void
+}
+
+export function withAcceptedDispatch(params: Record<string, unknown>, identity: AcceptedSessionIdentity | undefined,
+  onDispatch: () => void): GuardedParams {
+  if (!(identity instanceof LegacyContinuation)) { onDispatch(); return params }
+  return { ...params, [dispatchGuard]: (wire, legacy) => {
+    identity.signal.throwIfAborted()
+    if (!legacy || wire.profile !== identity.profile || wire.session_id !== identity.runtimeSessionId) {
+      throw new Error('Select the session again before sending.')
+    }
+    onDispatch()
+  } }
+}
+
+export function confirmAcceptedDispatch(params: GuardedParams, legacy: boolean): void {
+  params[dispatchGuard]?.(params, legacy)
+}
+
+export function matchesAcceptedContinuation(identity: AcceptedSessionIdentity, requested: string): boolean {
+  return identity instanceof LegacyContinuation && identity.requested === requested && !identity.signal.aborted
+}
