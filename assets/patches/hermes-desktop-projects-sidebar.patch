+    const archived = clickedOwner || observed?.profile?.trim() || observed?.connection_id?.trim()
+      ? original : (await resolveStoredSession(id)) ?? original
+
+    const identity = clickedOwner ? sessionMutationOwnerIdentity(clickedOwner) : archived ? sessionTitleOwner(archived) : {}
+    const connectionId = identity.connection_id?.trim() || null
+    const profile = identity.profile?.trim() || (connectionId ? 'default' : undefined)
+
+    if (!context.current() || (!profile && !connectionId && !ambientGatewayOwnsEverySession())) {
+      throw new SessionOwnerResolutionError(id, 'archive')
+    }
+
+    const route = context.capture({ connectionId, profile: (typeof clickedOwner === 'object' && clickedOwner?.targetProfile) || profile || null })
+    const archivedIds = archived ? [id, ...tombstoneRowIds(archived)] : [id]
+    const cacheOwner = archived ? listedArchiveOwner(archived) : identity
+    const target = archiveProjection(archivedIds, sessionArchiveOwnerKey(cacheOwner))
+    const settle = beginSessionArchive(archivedIds, cacheOwner)
+
+    if (!settle) { return }
+
+    const restoreRows = evictListedSessions(candidate => target.matchesOwner(candidate) &&
+      tombstoneRowIds(candidate).some(related => archivedIds.includes(related)))
+
+    const restorePins = removeArchivePins([id, archived ? sessionPinId(archived) : id], target.hasSibling)
+    const selected = effects.selected()
+    const activeOwner = runtimeSessionOwner(selected.runtimeId)
+
+    if (selected.id && archivedIds.includes(selected.id) && (activeOwner ? target.belongs(activeOwner) : !target.hasSibling(selected.id))) {
+      effects.clearSelection()
+    }
+
+    try {
+      const result = await setSessionArchived(archived?.id ?? id, true, route)
+
+      if (!result.ok) { throw new Error(effects.archiveFailed) }
+    } catch (error) {
+      settle(false)
+
+      if (route.current()) {
+        restoreRows()
+        restorePins()
+      }
+
+      throw error
+    }
+
+    settle(true)
+
+    if (!target.siblings().some(candidate => (sessionTitleOwner(candidate).profile?.trim() || 'default') === (profile || 'default'))) {
+      forgetSessionUnread(archivedIds, profile)
+    }
+
+    if (route.current()) {
+      const tiles = $sessionTiles.get().filter(tile => archivedIds.includes(tile.storedSessionId) &&
+        ((tile.ownerRoute || tile.ownerProfile) ? target.belongs(tile.ownerRoute ?? tile.ownerProfile) : !target.hasSibling(tile.storedSessionId)))
+
+      for (const tile of tiles) {
+        closeSessionTile(tile.storedSessionId)
+        effects.dropTileRuntime(tile.storedSessionId, tile.runtimeId)
+      }
+    }
+
+    notify({ durationMs: 2_000, kind: 'success', message: effects.archived })
+  } catch (error) {
+    notifyError(error, effects.archiveFailed)
+  }
+}
+
+export async function restoreArchivedSession(id: string, row?: SessionInfo): Promise<void> {
+  const context = captureSessionMutationContext()
+  const candidates = $archivedSessions.get().filter(candidate => sessionMatchesStoredId(candidate, id))
+  if (!row && new Set(candidates.map(listedArchiveOwnerKey)).size > 1) {
+    throw new SessionOwnerResolutionError(id, 'unarchive')
+  }
+  const archived = row ?? candidates[0]
+  const connectionId = archived?.connection_id?.trim() || null
+  const profile = archived?.profile?.trim() || (connectionId ? 'default' : await resolveSessionProfile(id))
+  if (!context.current() || (!profile && !ambientGatewayOwnsEverySession())) {
+    throw new SessionOwnerResolutionError(id, 'unarchive')
+  }
+  const route = context.capture({ connectionId, profile: profile ?? null })
+  const result = await setSessionArchived(archived?.id ?? id, false, route)
+  if (!result.ok) { throw new Error('Unarchive was refused') }
+  if (!archived) { return }
+
+  const restored = { ...archived, archived: false, ...(profile ? { profile } : {}) }
+  const cacheOwner = listedArchiveOwner(restored)
+  const ownerKey = sessionArchiveOwnerKey(cacheOwner)
+  const matchesOwner = (candidate: SessionInfo) => candidate === archived || listedArchiveOwnerKey(candidate) === ownerKey
+  releaseSessionArchive([id, ...tombstoneRowIds(archived)], cacheOwner)
+  if (route.current()) {
+    $archivedSessions.set($archivedSessions.get().filter(candidate =>
+      !matchesOwner(candidate) || !sessionMatchesStoredId(candidate, id)))
+    restoreListedSession(restored, undefined, matchesOwner)
+  }
+}
