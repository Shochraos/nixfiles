+import { setSessionArchived } from '@/hermes'
+import { sessionArchiveOwnerKey, sessionMutationOwnerIdentity } from '@/lib/session-mutation-identity'
+import { $pinnedSessionIds } from '@/store/layout'
+import { clearNotifications, notify, notifyError } from '@/store/notifications'
+import { $cronSessions, $messagingSessions, $sessions, $unlistedSessionOwnerRows, ownerLookupSessionRows, sessionPinId, sessionTitleOwner } from '@/store/session'
+import { captureSessionMutationContext } from '@/store/session-mutation-owner'
+import { ambientGatewayOwnsEverySession, SessionOwnerResolutionError } from '@/store/session-owner-resolution'
+import { beginSessionArchive, releaseSessionArchive, tombstoneRowIds } from '@/store/session-removal'
+import { type SessionOwnerScope } from '@/store/session-request-router'
+import { $sessionTiles, closeSessionTile, runtimeSessionOwner } from '@/store/session-states'
+import { forgetSessionUnread } from '@/store/session-unread'
+import { $archivedSessions } from '@/store/sidebar-archive'
+import type { SessionInfo } from '@/types/hermes'
+
+import { resolveSessionProfile, resolveStoredSession, restoreListedSession, sessionMatchesStoredId } from './utils'
+
+interface ArchiveEffects {
+  archived: string
+  archiveFailed: string
+  selected: () => { id: string | null; runtimeId: string | null }
+  clearSelection: () => void
+  dropTileRuntime: (storedId: string, runtimeId?: string) => void
+}
+
+const listedArchiveOwner = (row: SessionInfo) => ({ ...sessionTitleOwner(row), projectCacheConnectionId: row.projectCacheConnectionId })
+export const listedArchiveOwnerKey = (row: SessionInfo) => sessionArchiveOwnerKey(listedArchiveOwner(row))
+
+function captureArchiveTarget(id: string, row?: SessionInfo, clickedOwner?: SessionOwnerScope) {
+  const candidates = ownerLookupSessionRows().filter(session => sessionMatchesStoredId(session, id))
+
+  if (clickedOwner) {
+    const owner = sessionMutationOwnerIdentity(clickedOwner)
+
+    const key = sessionArchiveOwnerKey(owner)
+    const matches = (candidate: SessionInfo) => listedArchiveOwnerKey(candidate) === key
+    return row && matches(row) ? row : candidates.find(matches)
+  }
+
+  if (row) {
+    return row
+  }
+
+  if (new Set(candidates.map(listedArchiveOwnerKey)).size > 1) {
+    throw new SessionOwnerResolutionError(id, 'archive')
+  }
+
+  return candidates[0]
+}
+
+function removeArchivePins(ids: string[], hasSibling: (id: string) => boolean) {
+  const previous = $pinnedSessionIds.get()
+  const dropped = previous.filter(id => ids.includes(id) && !hasSibling(id))
+
+  if (dropped.length) {
+    $pinnedSessionIds.set(previous.filter(id => !dropped.includes(id)))
+  }
+
+  return () => {
+    const pins = $pinnedSessionIds.get()
+    const missing = dropped.filter(id => !pins.includes(id))
+
+    if (!missing.length) { return }
+    const next = [...pins]
+
+    for (const id of missing) { next.splice(previous.indexOf(id), 0, id) }
+    $pinnedSessionIds.set(next)
+  }
+}
+
+function evictListedSessions(matches: (row: SessionInfo) => boolean): () => void {
+  const slices = [$sessions, $messagingSessions, $cronSessions, $unlistedSessionOwnerRows]
+
+  const removed = slices.flatMap(store => {
+    const rows = store.get()
+    const evicted = rows.filter(matches)
+
+    if (!evicted.length) { return [] }
+    store.set(rows.filter(row => !matches(row)))
+
+    return [{ store, evicted }]
+  })
+
+  return () => {
+    for (const { store, evicted } of removed) {
+      const current = store.get()
+
+      if (!current.some(matches)) {
+        store.set([...evicted, ...current])
+      }
+    }
+  }
+}
+
+function archiveProjection(ids: string[], ownerKey: string) {
+  const belongs = (owner: SessionOwnerScope) => sessionArchiveOwnerKey(sessionMutationOwnerIdentity(owner)) === ownerKey
+  const matchesOwner = (candidate: SessionInfo) => listedArchiveOwnerKey(candidate) === ownerKey
+
+  const siblings = () => ownerLookupSessionRows().filter(candidate => !matchesOwner(candidate) &&
+    tombstoneRowIds(candidate).some(id => ids.includes(id)))
+
+  const tileIsSibling = (id: string) => $sessionTiles.get().some(tile => tile.storedSessionId === id &&
+    (tile.ownerRoute || tile.ownerProfile) && !belongs(tile.ownerRoute ?? tile.ownerProfile))
+
+  const hasSibling = (id: string) => tileIsSibling(id) || siblings().some(candidate => sessionMatchesStoredId(candidate, id))
+
+  return { belongs, matchesOwner, siblings, hasSibling }
+}
+
+export async function archiveStoredSession(id: string, row: SessionInfo | undefined, clickedOwner: SessionOwnerScope,
+  effects: ArchiveEffects): Promise<void> {
+  clearNotifications()
