+import { $apiRequestScope, type ResolvedOwner } from '@/api/client'
+import type { CapturedSessionMutationOwner } from '@/api/sessions'
+
+import { $connectionsRegistry } from './connection-registry-state'
+import { activeGateway } from './gateway'
+import { $gatewayActivationEpoch } from './gateway-activation-epoch'
+import { $activeGatewayProfile, $profileScope } from './profile'
+
+export function captureSessionMutationContext() {
+  const scope = $apiRequestScope.get()
+  const activationEpoch = $gatewayActivationEpoch.get()
+  const gateway = activeGateway()
+  const shownProfile = $activeGatewayProfile.get()
+  const profileScope = $profileScope.get()
+  const registry = $connectionsRegistry.get()
+
+  const current = () => activeGateway() === gateway && $gatewayActivationEpoch.get() === activationEpoch &&
+    $apiRequestScope.get() === scope && $activeGatewayProfile.get() === shownProfile &&
+    $profileScope.get() === profileScope && $connectionsRegistry.get() === registry
+
+  const capture = ({ connectionId, profile }: ResolvedOwner): CapturedSessionMutationOwner => ({
+    activationEpoch, current, connectionId, profile: profile ?? scope.profile
+  })
+
+  return { capture, current, gateway, scope, shownProfile }
+}
