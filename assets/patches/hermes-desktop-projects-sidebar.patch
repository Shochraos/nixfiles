@@ -0,0 +1,248 @@
+export interface ArchivePlacement {
+  has_archived_attachments: boolean
+  classified_session_ids: string[]
+  archive_home_session_ids: string[]
+}
+
+export interface ArchiveSlice {
+  profile: string
+  status: 'ok' | 'missing_store' | 'unavailable' | 'unsupported'
+  tree_status: 'ok' | 'missing_store' | 'unavailable'
+  archived_projects: { id: string; name: string }[]
+  placement?: ArchivePlacement
+}
+
+export interface SidebarGroup {
+  id: string
+  name: string
+  created_at: number
+}
+
+export interface SidebarGroupMembership {
+  project_id: string
+  group_id: string
+}
+
+export type SidebarGroupCommand =
+  | { action: 'create'; name: string }
+  | { action: 'assign'; project_id: string; group_id: string | null }
+  | { action: 'delete'; group_id: string }
+
+export interface SidebarGroupReply {
+  group_id: string | null
+  changed: boolean
+}
+
+export const wireRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value)
+
+export const wireId = (value: unknown): value is string => typeof value === 'string' && value.length > 0
+export const wireProfile = (value: unknown): value is string =>
+  wireId(value) && value === value.trim() && value.toLowerCase() !== 'all'
+export const wireGroupId = (value: unknown): value is string =>
+  typeof value === 'string' && value.length === 34 && /^g_[0-9a-f]{32}$/.test(value)
+
+export function decodeArchivePlacement(value: unknown): ArchivePlacement | undefined {
+  if (!wireRecord(value)) {
+    return
+  }
+
+  const { has_archived_attachments, classified_session_ids, archive_home_session_ids } = value
+
+  if (
+    typeof has_archived_attachments !== 'boolean' ||
+    !Array.isArray(classified_session_ids) ||
+    !classified_session_ids.every(wireId) ||
+    !Array.isArray(archive_home_session_ids) ||
+    !archive_home_session_ids.every(wireId)
+  ) {
+    return
+  }
+
+  const classified = new Set(classified_session_ids)
+
+  if (
+    (!has_archived_attachments && (classified.size || archive_home_session_ids.length)) ||
+    !archive_home_session_ids.every(id => classified.has(id))
+  ) {
+    return
+  }
+
+  return { has_archived_attachments, classified_session_ids, archive_home_session_ids }
+}
+
+export function decodeArchiveSlice(value: unknown, allowUnsupported = false): ArchiveSlice | undefined {
+  return parseArchiveSlice(value, allowUnsupported, false)
+}
+
+function parseArchiveSlice(value: unknown, allowUnsupported: boolean, allowLiteralAll: boolean): ArchiveSlice | undefined {
+  if (!wireRecord(value)) {
+    return
+  }
+
+  const { profile, status, tree_status, archived_projects } = value
+  const ambiguous = allowLiteralAll && profile === 'all'
+
+  if (
+    (!ambiguous && !wireProfile(profile)) ||
+    !(
+      status === 'ok' ||
+      status === 'missing_store' ||
+      status === 'unavailable' ||
+      (allowUnsupported && status === 'unsupported')
+    ) ||
+    !(tree_status === 'ok' || tree_status === 'missing_store' || tree_status === 'unavailable') ||
+    (status === 'unsupported' && tree_status !== 'ok') ||
+    !Array.isArray(archived_projects) ||
+    (status !== 'ok' && archived_projects.length > 0)
+  ) {
+    return
+  }
+
+  const projects: ArchiveSlice['archived_projects'] = []
+  const seen = new Set<string>()
+
+  for (const row of archived_projects) {
+    if (!wireRecord(row) || !wireId(row.id) || typeof row.name !== 'string' || seen.has(row.id)) {
+      return
+    }
+
+    projects.push({ id: row.id, name: row.name })
+    seen.add(row.id)
+  }
+
+  const placement = decodeArchivePlacement(value.placement)
+
+  if ('placement' in value && (!placement || tree_status === 'unavailable' || status === 'unsupported')) {
+    return
+  }
+
+  return ambiguous
+    ? { profile, status: 'unavailable', tree_status: 'unavailable', archived_projects: [] }
+    : { profile, status, tree_status, archived_projects: projects, ...(placement ? { placement } : {}) }
+}
+
+export function decodeTreeArchiveSlices(
+  res: Record<string, unknown>,
+  profile: string | null,
+  { rawAggregate = false }: { rawAggregate?: boolean } = {}
+): ArchiveSlice[] | 'unsupported' | 'unavailable' {
+  if (!('archive_slices' in res)) {
+    return Array.isArray(res.errors) && res.errors.length ? 'unavailable' : 'unsupported'
+  }
+
+  if (!Array.isArray(res.archive_slices)) {
+    return 'unavailable'
+  }
+
+  const slices: ArchiveSlice[] = []
+  const seen = new Set<string>()
+
+  for (const value of res.archive_slices) {
+    const allowLiteralAll = profile === null && wireRecord(value) && value.profile === 'all' &&
+      (rawAggregate || (value.status === 'unavailable' && value.tree_status === 'unavailable'))
+
+    const slice = parseArchiveSlice(value, !profile, allowLiteralAll)
+
+    if (!slice || seen.has(slice.profile)) {
+      return 'unavailable'
+    }
+
+    seen.add(slice.profile)
+    slices.push(slice)
+  }
+
+  return profile && (slices.length !== 1 || slices[0].profile !== profile) ? 'unavailable' : slices
+}
+
+export function decodeTreeGroups(
+  res: Record<string, unknown>,
+  supported: boolean
+): { groups: SidebarGroup[] | null; memberships: SidebarGroupMembership[] } {
+  const unavailable = { groups: null, memberships: [] }
+
+  if (!supported || !Array.isArray(res.sidebar_groups) || !Array.isArray(res.sidebar_group_memberships)) {
+    return unavailable
+  }
+
+  const groups = new Map<string, SidebarGroup>()
+  const memberships = new Map<string, SidebarGroupMembership>()
+
+  for (const group of res.sidebar_groups) {
+    if (
+      !wireRecord(group) ||
+      !wireGroupId(group.id) ||
+      !wireId(group.name) ||
+      typeof group.created_at !== 'number' ||
+      !Number.isSafeInteger(group.created_at) ||
+      groups.has(group.id)
+    ) {
+      return unavailable
+    }
+
+    groups.set(group.id, { id: group.id, name: group.name, created_at: group.created_at })
+  }
+
+  for (const membership of res.sidebar_group_memberships) {
+    if (
+      !wireRecord(membership) ||
+      !wireId(membership.project_id) ||
+      !wireGroupId(membership.group_id) ||
+      !groups.has(membership.group_id) ||
+      memberships.has(membership.project_id)
+    ) {
+      return unavailable
+    }
+
+    memberships.set(membership.project_id, { project_id: membership.project_id, group_id: membership.group_id })
+  }
+
+  return {
+    groups: [...groups.values()].sort((a, b) => a.created_at - b.created_at || (a.id < b.id ? -1 : 1)),
+    memberships: [...memberships.values()]
+  }
+}
+
+export function scopedArchiveSlice(profile: string, response: unknown): ArchiveSlice {
+  const unavailable: ArchiveSlice = {
+    profile,
+    status: 'unavailable',
+    tree_status: 'unavailable',
+    archived_projects: []
+  }
+
+  if (!wireRecord(response)) {
+    return unavailable
+  }
+
+  const { archive_slices } = response
+  const treeOk = Array.isArray(response.projects) && !(Array.isArray(response.errors) && response.errors.length)
+
+  if (!('archive_slices' in response)) {
+    return treeOk ? { ...unavailable, status: 'unsupported', tree_status: 'ok' } : unavailable
+  }
+
+  const matches = Array.isArray(archive_slices)
+    ? archive_slices.filter(slice => wireRecord(slice) && slice.profile === profile)
+    : []
+  const slice = matches.length === 1 ? decodeArchiveSlice(matches[0]) : undefined
+
+  return slice ?? (treeOk ? { ...unavailable, tree_status: 'ok' } : unavailable)
+}
+
+export function decodeSidebarGroupReply(reply: unknown, command: SidebarGroupCommand): SidebarGroupReply {
+  const groupId = wireRecord(reply) && wireGroupId(reply.group_id) ? reply.group_id : null
+
+  if (
+    !wireRecord(reply) ||
+    typeof reply.changed !== 'boolean' ||
+    (reply.group_id !== null && groupId === null) ||
+    (command.action === 'create' && (!reply.changed || groupId === null)) ||
+    ('group_id' in command && groupId !== command.group_id) ||
+    (command.action === 'delete' && !reply.changed)
+  ) {
+    throw new Error('Malformed project folder acknowledgement')
+  }
+
+  return { group_id: groupId, changed: reply.changed }
+}
