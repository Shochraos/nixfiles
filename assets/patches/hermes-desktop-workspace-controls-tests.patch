+import { describe, expect, it, vi } from 'vitest'
+
+import { loadProjectFolders, removeProjectFolder } from './project-folder-management'
+
+const owner = { connectionId: 'remote-a', profile: 'research', projectId: 'p1' }
+const project = {
+  id: 'p1', primary_path: '/a', folders: [
+    { path: '/a', is_primary: true }, { path: '/b', is_primary: false }
+  ]
+}
+
+describe('project folder management', () => {
+  it('uses the captured owner and exact path, accepting the backend primary reassignment', async () => {
+    const updated = { ...project, primary_path: '/b', folders: [project.folders[1]] }
+    const request = vi.fn().mockResolvedValueOnce({ project }).mockResolvedValueOnce({ project: updated })
+    const loaded = await loadProjectFolders(owner, request)
+    expect(await removeProjectFolder(owner, loaded, '/a', request)).toEqual(updated)
+    expect(request).toHaveBeenLastCalledWith(owner, 'projects.remove_folder', { id: 'p1', path: '/a', profile: 'research' })
+  })
+
+  it('keeps the project when the backend removes the last attachment', async () => {
+    const updated = { ...project, primary_path: null, folders: [] }
+    const lastFolder = { ...project, folders: [project.folders[0]] }
+    expect(await removeProjectFolder(owner, lastFolder, '/a', vi.fn().mockResolvedValue({ project: updated }))).toEqual(updated)
+  })
+
+  it('rejects absent attachments and unverified removals', async () => {
+    const request = vi.fn().mockResolvedValue({ project })
+    await expect(removeProjectFolder(owner, project, '/missing', request)).rejects.toMatchObject({ reason: 'missingAttachment' })
+    expect(request).not.toHaveBeenCalled()
+    await expect(removeProjectFolder(owner, project, '/a', request)).rejects.toMatchObject({ reason: 'stillAttached' })
+    await expect(loadProjectFolders(owner, vi.fn().mockResolvedValue({ project: { ...project, id: 'p2' } }))).rejects.toMatchObject({ reason: 'invalidResponse' })
+  })
+})
