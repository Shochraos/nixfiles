+
+afterEach(cleanup)
+
+describe('ProjectFolderDialog', () => {
+  it('lists saved attachments, removes the chosen path and reflects the backend primary', async () => {
+    const updated = { ...project, primary_path: '/two', folders: [{ path: '/two', is_primary: true }] }
+    const request = vi.fn().mockResolvedValueOnce({ project }).mockResolvedValueOnce({ project: updated })
+    const refresh = vi.fn().mockResolvedValue(undefined)
+    render(<ProjectFolderDialog name="Work" onClose={vi.fn()} owner={owner} refresh={refresh} request={request} />)
+    expect(await screen.findByText('/one')).toBeTruthy()
+    expect(screen.getByText('/two')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Remove /one from project' }))
+    await waitFor(() => expect(screen.queryByText('/one')).toBeNull())
+    expect(request).toHaveBeenLastCalledWith(owner, 'projects.remove_folder', { id: 'p1', path: '/one', profile: 'research' })
+    expect(refresh).toHaveBeenCalledWith(owner, updated)
+    expect(screen.getByText('Primary')).toBeTruthy()
+  })
+
+  it('shows a failure and preserves the attachment when the server did not remove it', async () => {
+    const request = vi.fn().mockResolvedValue({ project })
+    render(<ProjectFolderDialog name="Work" onClose={vi.fn()} owner={owner} refresh={vi.fn()} request={request} />)
+    await screen.findByText('/one')
+    fireEvent.click(screen.getByRole('button', { name: 'Remove /one from project' }))
+    expect((await screen.findByRole('alert')).textContent).toBe('The folder is still attached to the project.')
+    expect(screen.getByText('/one')).toBeTruthy()
+  })
+
+  it('localizes validation errors while preserving backend failures', async () => {
+    const request = vi.fn().mockResolvedValueOnce({ project }).mockResolvedValueOnce({ project })
+    const { unmount } = render(<I18nProvider initialLocale="de" configClient={null}>
+      <ProjectFolderDialog name="Work" onClose={vi.fn()} owner={owner} refresh={vi.fn()} request={request} />
+    </I18nProvider>)
+    await screen.findByText('/one')
+    fireEvent.click(screen.getByRole('button', { name: '/one aus Projekt entfernen' }))
+    expect((await screen.findByRole('alert')).textContent).toBe('Der Ordner ist dem Projekt noch zugeordnet.')
+    unmount()
+    render(<ProjectFolderDialog name="Work" onClose={vi.fn()} owner={owner} refresh={vi.fn()}
+      request={vi.fn().mockRejectedValue(new Error('gateway offline'))} />)
+    expect((await screen.findByRole('alert')).textContent).toBe('gateway offline')
+  })
+
+  it('prevents duplicate removal and closing while a request is pending', async () => {
+    let finish!: (result: unknown) => void
+    const request = vi.fn().mockResolvedValueOnce({ project }).mockImplementationOnce(() => new Promise(resolve => { finish = resolve }))
+    const onClose = vi.fn()
+    render(<ProjectFolderDialog name="Work" onClose={onClose} owner={owner} refresh={vi.fn().mockResolvedValue(undefined)} request={request} />)
+    await screen.findByText('/one')
+    const remove = screen.getByRole('button', { name: 'Remove /one from project' }) as HTMLButtonElement
+    fireEvent.click(remove)
+    expect(remove.disabled).toBe(true)
+    expect((screen.getByRole('button', { name: 'Done' }) as HTMLButtonElement).disabled).toBe(true)
+    fireEvent.click(remove)
+    expect(request).toHaveBeenCalledTimes(2)
+    finish({ project: { ...project, primary_path: '/two', folders: [project.folders[1]] } })
+    await waitFor(() => expect(screen.queryByText('/one')).toBeNull())
+    expect(onClose).not.toHaveBeenCalled()
+  })
+
+  it('cancels without a mutation', async () => {
+    const request = vi.fn().mockResolvedValue({ project })
+    const onClose = vi.fn()
+    render(<ProjectFolderDialog name="Work" onClose={onClose} owner={owner} refresh={vi.fn()} request={request} />)
+    await screen.findByText('/one')
+    fireEvent.click(screen.getByRole('button', { name: 'Done' }))
+    expect(onClose).toHaveBeenCalledOnce()
+    expect(request).toHaveBeenCalledTimes(1)
+  })
+})
