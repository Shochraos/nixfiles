+import { beforeEach, expect, it, vi } from 'vitest'
+
+const fixture = vi.hoisted(() => ({
+  selected: 'saved', runtime: 'runtime', cwd: '/old', busy: false,
+  rows: [] as any[], states: {} as Record<string, any>, tiles: [] as any[], removed: new Set<string>(),
+  route: { connectionId: 'remote-a', profile: 'work', mode: 'remote' },
+  request: vi.fn(), read: vi.fn(), refresh: vi.fn(), update: vi.fn(), branch: vi.fn()
+}))
+const atom = (get: () => unknown) => ({ get })
+vi.mock('@/api/sessions', () => ({ getSession: fixture.read }))
+vi.mock('@/store/gateway', () => ({
+  activeGatewayConnectionId: () => 'local', activeGatewayProfileKey: () => 'default',
+  requestGatewayForAgent: fixture.request
+}))
+vi.mock('@/store/profile', () => ({
+  $activeGatewayProfile: atom(() => 'default'), $newChatProfile: atom(() => 'default'),
+  $freshSessionRequest: atom(() => 0), resolveNewChatOwnerRoute: () => fixture.route
+}))
+vi.mock('@/store/session', () => ({
+  $activeSessionId: atom(() => fixture.runtime), $selectedStoredSessionId: atom(() => fixture.selected),
+  $currentCwd: atom(() => fixture.cwd), $busy: atom(() => fixture.busy), $awaitingResponse: atom(() => false),
+  $newChatWorkspaceTargetGeneration: atom(() => 0),
+  ownerLookupSessionRows: () => fixture.rows,
+  sessionMatchesStoredId: (row: any, id: string) => row.id === id,
+  setSessions: (update: any) => { fixture.rows = update(fixture.rows) },
+  setCronSessions: vi.fn(), setMessagingSessions: vi.fn(),
+  commitWorkspaceCwdForSelectedSession: fixture.update, setCurrentBranch: fixture.branch,
+  setCurrentCwd: fixture.update, setCurrentCwdExplicit: vi.fn(), setNewChatWorkspaceTarget: vi.fn()
+}))
+vi.mock('@/store/session-focus', () => ({ $focusedStoredSessionId: atom(() => fixture.selected) }))
+vi.mock('@/store/session-states', () => ({
+  $focusedRuntimeId: atom(() => fixture.runtime), $sessionStates: atom(() => fixture.states),
+  knownOwnerForSession: () => fixture.route, ownerConnectionMode: () => 'remote',
+  sessionTileDelegate: () => null, publishSessionState: (id: string, state: any) => { fixture.states[id] = state }
+}))
+vi.mock('@/store/session-owner-resolution', () => ({ assertSessionOwnerResolved: vi.fn() }))
+vi.mock('@/store/session-removal', () => ({ $removedSessionIds: atom(() => fixture.removed) }))
+vi.mock('@/store/projects', () => ({ refreshProjectTreeForOwner: fixture.refresh }))
+vi.mock('@/store/project-scope', () => ({ $projectScope: atom(() => '__all_projects__'), exitProjectScope: vi.fn() }))
+vi.mock('@/lib/host-capabilities', () => ({ hostHas: () => true }))
+
+import { captureSessionWorkspaceTarget, moveSessionWorkspace, workspaceRowMatches } from './session-workspace-move'
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  fixture.selected = 'saved'
+  fixture.runtime = 'runtime'
+  fixture.cwd = '/old'
+  fixture.busy = false
+  fixture.removed = new Set(['saved'])
+  fixture.rows = [
+    { id: 'saved', connection_id: 'remote-a', profile: 'work', cwd: '/old', git_repo_root: '/old', git_branch: 'old' },
+    { id: 'saved', connection_id: 'remote-b', profile: 'work', cwd: '/other', git_repo_root: '/other' }
+  ]
+  fixture.states = { runtime: { storedSessionId: 'saved', cwd: '/old', branch: 'old', busy: false } }
+  fixture.read.mockResolvedValue({ ...fixture.rows[0], cwd: '/new', git_repo_root: null, git_branch: null })
+  fixture.request.mockImplementation(async (_connection, _profile, method) => method === 'projects.tree'
+    ? { projects: [] }
+    : { session_id: 'saved', cwd: '/new', branch: null, git_repo_root: null })
+})
+
+it('moves the captured stored conversation on its owner after focus changes, without overwriting the primary', async () => {
+  const target = await captureSessionWorkspaceTarget('/old')
+  fixture.selected = 'another'
+  fixture.runtime = 'another-runtime'
+  await moveSessionWorkspace(target, '/new')
+  expect(fixture.request).toHaveBeenCalledWith('remote-a', 'work', 'session.workspace.move', {
+    session_key: 'saved', cwd: '/new', profile: 'work'
+  })
+  expect(fixture.rows[0]).toMatchObject({ cwd: '/new', git_repo_root: null, git_branch: null })
+  expect(fixture.rows[1]).toMatchObject({ cwd: '/other', git_repo_root: '/other' })
+  expect(fixture.states.runtime).toMatchObject({ cwd: '/new', branch: '' })
+  expect(fixture.update).not.toHaveBeenCalled()
+})
+
+it('does not attribute an untagged local row to a remote owner by session ID', async () => {
+  const target = await captureSessionWorkspaceTarget('/old')
+  expect(workspaceRowMatches(target, { id: 'saved', profile: 'work' } as any)).toBe(false)
+})
+
+it('ignores another owner’s same-ID tombstone and verifies the captured owner before mutation', async () => {
+  const target = await captureSessionWorkspaceTarget('/old')
+  await moveSessionWorkspace(target, '/new')
+  expect(fixture.read).toHaveBeenCalledWith('saved', { connectionId: 'remote-a', profile: 'work' })
+  expect(fixture.read.mock.invocationCallOrder[0]).toBeLessThan(fixture.request.mock.invocationCallOrder[0])
+})
+
+it('does not mutate when the captured owner no longer has the session', async () => {
+  const target = await captureSessionWorkspaceTarget('/old')
+  fixture.read.mockResolvedValueOnce(null)
+  await expect(moveSessionWorkspace(target, '/new')).rejects.toMatchObject({ reason: 'changed' })
+  expect(fixture.request).not.toHaveBeenCalled()
+})
