+async function readRegistryProjectFolders(
+  descriptor: unknown,
+  profile: string,
+  getJson: GetJsonForDescriptor
+): Promise<ProjectFolderScope | null | undefined> {
+  const params = new URLSearchParams({ profile, session_limit: '0', preview_limit: '0' })
+
+  try {
+    const payload = (await getJson(descriptor, `/api/profiles/projects/tree?${params}`, { profileScoped: true })) as {
+      projects?: unknown[]
+      projectFoldersByProfile?: Record<string, ProjectFolderScope>
+    } | null
+
+    if (!payload || typeof payload !== 'object' || errorsOf(payload)) {
+      return null
+    }
+
+    if (!Object.hasOwn(payload, 'projectFoldersByProfile')) {
+      return Array.isArray(payload.projects) ? undefined : null
+    }
+
+    const scopes = payload.projectFoldersByProfile
+
+    if (!scopes || typeof scopes !== 'object' || Array.isArray(scopes)) {
+      return null
+    }
+
+    if (!Object.hasOwn(scopes, profile)) {
+      return { active: [], archived: [] }
+    }
+
+    const scope = scopes[profile]
+
+    return scope && [scope.active, scope.archived].every(paths => Array.isArray(paths) && paths.every(path => typeof path === 'string'))
+      ? { active: scope.active, archived: scope.archived }
+      : null
+  } catch (error) {
+    return httpStatusOf(error) === 404 ? undefined : null
+  }
