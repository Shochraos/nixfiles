+import { getSession } from '@/api/sessions'
+import type { SessionInfo } from '@/types/hermes'
+import { hostHas } from '@/lib/host-capabilities'
+import { type DesktopFsPickerOwner, readDesktopDir } from '@/lib/desktop-fs'
+import { activeGatewayConnectionId, activeGatewayProfileKey, requestGatewayForAgent } from '@/store/gateway'
+import { $activeGatewayProfile, $freshSessionRequest, $newChatProfile, resolveNewChatOwnerRoute } from '@/store/profile'
+import { refreshProjectTreeForOwner } from '@/store/projects'
+import { $projectScope, exitProjectScope } from '@/store/project-scope'
+import {
+  $activeSessionId, $awaitingResponse, $busy, $currentCwd, $newChatWorkspaceTargetGeneration, $selectedStoredSessionId,
+  commitWorkspaceCwdForSelectedSession, ownerLookupSessionRows, sessionMatchesStoredId,
+  setCronSessions, setCurrentBranch, setCurrentCwd, setCurrentCwdExplicit, setMessagingSessions,
+  setNewChatWorkspaceTarget, setSessions
+} from '@/store/session'
+import { $focusedStoredSessionId } from '@/store/session-focus'
+import { assertSessionOwnerResolved } from '@/store/session-owner-resolution'
+import {
+  $focusedRuntimeId, $sessionStates, knownOwnerForSession, ownerConnectionMode,
+  publishSessionState, sessionTileDelegate
+} from '@/store/session-states'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+export interface SessionWorkspaceTarget {
+  storedSessionId: string | null
+  runtimeId: string | null
+  draft: boolean
+  startingCwd: string
+  title: string
+  owner: DesktopFsPickerOwner
+  requestProfile: string
+  draftGeneration: number
+  freshGeneration: number
+  projectScope: string
+}
+
+export class SessionWorkspaceError extends Error {
+  constructor(readonly reason: 'unavailable' | 'changed' | 'busy' | 'unverified' | 'refresh') {
+    super(reason)
+  }
+}
+
+function sameOwner(owner: DesktopFsPickerOwner, candidate: SessionOwnerScope): boolean {
+  if (!candidate) {
+    return false
+  }
+
+  return typeof candidate === 'string'
+    ? !owner.connectionId && candidate === owner.profile
+    : candidate.connectionId === owner.connectionId && (candidate.targetProfile ?? candidate.profile) === owner.profile
+}
+
+export function workspaceRowMatches(target: SessionWorkspaceTarget, row: SessionInfo): boolean {
+  if (!target.storedSessionId || !sessionMatchesStoredId(row, target.storedSessionId)) {
+    return false
+  }
+
+  if (row.connection_id) {
+    return row.connection_id === target.owner.connectionId &&
+      (row.profile || 'default') === target.requestProfile
+  }
+
+  if (row.profile && row.profile !== target.requestProfile) {
+    return false
+  }
+
+  return !target.owner.remote && (!target.owner.connectionId || target.owner.connectionId === 'local')
+}
+
+export async function captureSessionWorkspaceTarget(startingCwd: string): Promise<SessionWorkspaceTarget> {
+  const storedSessionId = $focusedStoredSessionId.get()
+  const candidateRuntime = $focusedRuntimeId.get()
+  const state = candidateRuntime ? $sessionStates.get()[candidateRuntime] : undefined
+  const runtimeId = state?.storedSessionId && storedSessionId && state.storedSessionId !== storedSessionId
+    ? null : candidateRuntime
+  const draft = !storedSessionId && !runtimeId
+  const owner = draft
+    ? resolveNewChatOwnerRoute() ?? ($newChatProfile.get() || $activeGatewayProfile.get())
+    : knownOwnerForSession(storedSessionId || runtimeId)
+  assertSessionOwnerResolved(owner, { method: 'session.workspace.move', sessionId: storedSessionId || runtimeId })
+  const requestProfile = typeof owner === 'string' ? owner : owner?.profile || $activeGatewayProfile.get()
+  let connectionId = typeof owner === 'object' && owner ? owner.connectionId : undefined
+  let profile = typeof owner === 'object' && owner ? owner.targetProfile ?? owner.profile : requestProfile
+  let mode = ownerConnectionMode(owner)
+  const draftGeneration = $newChatWorkspaceTargetGeneration.get()
+  const freshGeneration = $freshSessionRequest.get()
+  const projectScope = $projectScope.get()
+  const row = ownerLookupSessionRows().find(candidate => sessionMatchesStoredId(candidate, storedSessionId || '') &&
+    (!candidate.connection_id || candidate.connection_id === connectionId) &&
+    (!candidate.profile || candidate.profile === requestProfile))
+
+  if (!mode) {
+    const bridge = window.hermesDesktop
+    const connection = connectionId
+      ? await bridge?.getConnectionFor?.({ connectionId, profile: requestProfile })
+      : await bridge?.getConnection?.(requestProfile)
+
+    if (!connection) {
+      throw new SessionWorkspaceError('unavailable')
+    }
+
+    mode = connection.mode
+    connectionId ||= connection.connectionId || undefined
+    profile = connection.profile || profile
+  }
+
+  const target: SessionWorkspaceTarget = {
+    storedSessionId, runtimeId, draft, startingCwd, requestProfile, draftGeneration, freshGeneration, projectScope,
+    title: row?.title || storedSessionId || runtimeId || '',
+    owner: { connectionId, profile, remote: mode === 'remote' || !hostHas('nativeHostFiles') }
+  }
+  assertWorkspaceTarget(target)
+
+  return target
+}
+
+function draftStillCurrent(target: SessionWorkspaceTarget): boolean {
+  const owner = resolveNewChatOwnerRoute() ?? ($newChatProfile.get() || $activeGatewayProfile.get())
+
+  return !$activeSessionId.get() && !$selectedStoredSessionId.get() &&
+    $freshSessionRequest.get() === target.freshGeneration &&
+    $newChatWorkspaceTargetGeneration.get() === target.draftGeneration &&
+    $currentCwd.get() === target.startingCwd && sameOwner(target.owner, owner)
+}
+
+function runtimeMatches(target: SessionWorkspaceTarget, runtimeId: string): boolean {
+  const state = $sessionStates.get()[runtimeId]
+
+  return Boolean(state && sameOwner(target.owner, knownOwnerForSession(runtimeId)) &&
+    (target.storedSessionId ? state.storedSessionId === target.storedSessionId : runtimeId === target.runtimeId))
+}
+
+function primaryMatches(target: SessionWorkspaceTarget): boolean {
+  const selected = $selectedStoredSessionId.get()
+  const runtime = $activeSessionId.get()
+
+  return Boolean(target.storedSessionId
+    ? selected === target.storedSessionId && sameOwner(target.owner, knownOwnerForSession(selected))
+    : runtime && runtime === target.runtimeId && runtimeMatches(target, runtime))
+}
+
+export function assertWorkspaceTarget(target: SessionWorkspaceTarget): void {
+  if (target.draft && !draftStillCurrent(target)) {
+    throw new SessionWorkspaceError('changed')
+  }
+
+  if (!target.draft && !target.storedSessionId && (!target.runtimeId || !runtimeMatches(target, target.runtimeId))) {
+    throw new SessionWorkspaceError('changed')
+  }
+
+  const running = Object.entries($sessionStates.get()).some(([id, state]) =>
+    runtimeMatches(target, id) && (state.busy || state.awaitingResponse || state.turnLive))
+
+  if (running || ((target.draft || primaryMatches(target)) && ($busy.get() || $awaitingResponse.get()))) {
+    throw new SessionWorkspaceError('busy')
+  }
+}
+
+function requestForTarget<T>(target: SessionWorkspaceTarget, method: string, params: Record<string, unknown>) {
+  return requestGatewayForAgent<T>(target.owner.connectionId || null, target.requestProfile, method, {
+    ...params, profile: target.owner.profile
+  })
+}
+
+function updateWorkspaceCaches(target: SessionWorkspaceTarget, info: WorkspaceReceipt): void {
+  const patchRows = (rows: SessionInfo[]) => rows.map(row => workspaceRowMatches(target, row)
+    ? { ...row, cwd: info.cwd, git_branch: info.branch ?? null, git_repo_root: info.git_repo_root ?? null }
+    : row)
+  setSessions(patchRows)
+  setCronSessions(patchRows)
+  setMessagingSessions(patchRows)
+
+  for (const [runtimeId, state] of Object.entries($sessionStates.get())) {
+    if (!runtimeMatches(target, runtimeId)) {
+      continue
+    }
+
+    const update = (current: typeof state) => ({ ...current, cwd: info.cwd, branch: info.branch || '' })
+
+    if (!sessionTileDelegate()?.updateHeldSession?.(runtimeId, update)) {
+      publishSessionState(runtimeId, update(state))
+    }
+  }
+
+  if (primaryMatches(target)) {
+    commitWorkspaceCwdForSelectedSession(info.cwd)
+    setCurrentBranch(info.branch || '')
+  }
+}
+
+interface WorkspaceReceipt {
+  cwd: string
+  branch?: string | null
+  git_repo_root?: string | null
+}
+
+async function refreshWorkspaceTree(target: SessionWorkspaceTarget): Promise<void> {
+  await refreshProjectTreeForOwner(
+    { connectionId: target.owner.connectionId || null, profile: target.requestProfile },
+    (method, params) => requestForTarget(target, method, params)
+  )
+
+  if ((activeGatewayConnectionId() || undefined) === target.owner.connectionId &&
+    activeGatewayProfileKey() === target.requestProfile) {
+    if (primaryMatches(target) && $focusedStoredSessionId.get() === target.storedSessionId &&
+      $projectScope.get() === target.projectScope) {
+      exitProjectScope()
+    }
+  }
+}
+
+export async function moveSessionWorkspace(target: SessionWorkspaceTarget, cwd: string): Promise<void> {
+  assertWorkspaceTarget(target)
+  const destination = cwd.trim()
+
+  if (!destination) {
+    throw new SessionWorkspaceError('unverified')
+  }
+
+  if (target.draft) {
+    const directory = await readDesktopDir(destination, target.owner)
+
+    if (directory.error) {
+      throw new Error(directory.error)
+    }
+
+    const info = await requestForTarget<WorkspaceReceipt>(target, 'config.get', { key: 'project', cwd: destination })
+    assertWorkspaceTarget(target)
+    setCurrentCwd(info.cwd || destination)
+    setCurrentCwdExplicit(true)
+    setNewChatWorkspaceTarget(info.cwd || destination)
+    setCurrentBranch(info.branch || '')
+
+    return
+  }
+
+  const method = target.storedSessionId ? 'session.workspace.move' : 'session.cwd.set'
+  const identity = target.storedSessionId ? { session_key: target.storedSessionId } : { session_id: target.runtimeId }
+
+  if (target.storedSessionId) {
+    const existing = await getSession(target.storedSessionId, {
+      connectionId: target.owner.connectionId, profile: target.owner.profile
+    })
+    if (!existing || !sessionMatchesStoredId(existing, target.storedSessionId)) {
+      throw new SessionWorkspaceError('changed')
+    }
+    assertWorkspaceTarget(target)
+  }
+
+  const result = await requestForTarget<WorkspaceReceipt>(target, method, { ...identity, cwd: destination })
+
+  if (!result?.cwd) {
+    throw new SessionWorkspaceError('unverified')
+  }
+
+  if (target.storedSessionId) {
+    const saved = await getSession(target.storedSessionId, {
+      connectionId: target.owner.connectionId, profile: target.owner.profile
+    })
+
+    if (!sessionMatchesStoredId(saved, target.storedSessionId) || saved.cwd !== result.cwd) {
+      throw new SessionWorkspaceError('unverified')
+    }
+
+    result.branch = saved.git_branch ?? null
+    result.git_repo_root = saved.git_repo_root ?? null
+  }
+
+  updateWorkspaceCaches(target, result)
+
+  try {
+    await refreshWorkspaceTree(target)
+  } catch {
+    throw new SessionWorkspaceError('refresh')
+  }
+}
