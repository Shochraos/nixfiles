+const english = {
+  manage: 'Manage folders…',
+  title: (name: string) => `Manage folders — ${name}`,
+  description: 'Removing a folder from this project keeps its files and chats.',
+  primary: 'Primary',
+  empty: 'No folders attached.',
+  remove: 'Remove from project',
+  removePath: (path: string) => `Remove ${path} from project`,
+  loadFailed: 'Could not load project folders',
+  removeFailed: 'Could not remove the folder',
+  invalidResponse: 'The project attachments could not be verified.',
+  missingAttachment: 'The selected attachment is no longer available.',
+  stillAttached: 'The folder is still attached to the project.'
+}
+
+const german: typeof english = {
+  manage: 'Ordner verwalten…',
+  title: name => `Ordner verwalten — ${name}`,
+  description: 'Beim Entfernen eines Ordners aus diesem Projekt bleiben Dateien und Chats erhalten.',
+  primary: 'Primär',
+  empty: 'Keine Ordner zugeordnet.',
