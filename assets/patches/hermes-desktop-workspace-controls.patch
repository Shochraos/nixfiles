+  removePath: path => `${path} aus Projekt entfernen`,
+  loadFailed: 'Projektordner konnten nicht geladen werden',
+  removeFailed: 'Der Ordner konnte nicht entfernt werden',
+  invalidResponse: 'Die Projektordner konnten nicht überprüft werden.',
+  missingAttachment: 'Der ausgewählte Ordner ist nicht mehr zugeordnet.',
+  stillAttached: 'Der Ordner ist dem Projekt noch zugeordnet.'
+}
+
+export function projectFolderCopy(locale?: string): typeof english {
+  return locale === 'de' ? german : english
+}
