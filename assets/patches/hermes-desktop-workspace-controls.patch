+import { useEffect, useRef, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog'
+import { useI18n } from '@/i18n'
+import { projectFolderCopy } from '@/i18n/project-folder-copy'
+import {
+  loadProjectFolders,
+  ProjectFolderError,
+  type ProjectFolderOwner,
+  type ProjectFolderProject,
+  type ProjectFolderRequest,
+  removeProjectFolder
+} from '@/lib/project-folder-management'
+
+interface ProjectFolderDialogProps {
+  name: string
+  onClose: () => void
+  owner: ProjectFolderOwner
+  refresh: (owner: ProjectFolderOwner, project: ProjectFolderProject) => Promise<void>
+  request: ProjectFolderRequest
+}
+
+export function ProjectFolderDialog({ name, onClose, owner, refresh, request }: ProjectFolderDialogProps) {
+  const { t, locale } = useI18n()
+  const copy = projectFolderCopy(locale)
+  const [project, setProject] = useState<ProjectFolderProject | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const busy = useRef(false)
+  const mounted = useRef(true)
+  const errorMessage = (reason: unknown, fallback: string) => reason instanceof ProjectFolderError
+    ? copy[reason.reason] : reason instanceof Error ? reason.message : fallback
+
+  useEffect(() => {
+    mounted.current = true
+    let cancelled = false
+    void loadProjectFolders(owner, request).then(
+      result => { if (!cancelled) { setProject(result); setLoading(false) } },
+      reason => { if (!cancelled) { setError(errorMessage(reason, copy.loadFailed)); setLoading(false) } }
+    )
+    return () => { cancelled = true; mounted.current = false }
+  }, [owner, request])
+
+  async function remove(path: string) {
+    if (!project || busy.current) return
+    busy.current = true
+    setPending(true)
+    setError(null)
+    try {
+      const updated = await removeProjectFolder(owner, project, path, request)
+      if (mounted.current) setProject(updated)
+      await refresh(owner, updated)
+    } catch (reason) {
+      if (mounted.current) setError(errorMessage(reason, copy.removeFailed))
+    } finally {
+      busy.current = false
+      if (mounted.current) setPending(false)
+    }
+  }
+
+  return (
+    <Dialog onOpenChange={open => { if (!open && !pending) onClose() }} open>
+      <DialogContent className="max-w-lg">
+        <DialogHeader>
+          <DialogTitle>{copy.title(name)}</DialogTitle>
+          <DialogDescription>{copy.description}</DialogDescription>
+        </DialogHeader>
+        {loading && <p>{t.common.loading}</p>}
+        {error && <p role="alert" className="text-sm text-destructive">{error}</p>}
+        {project && (project.folders.length ? (
+          <ul className="grid max-h-80 gap-3 overflow-auto">
+            {project.folders.map(folder => (
+              <li className="flex items-center justify-between gap-3" key={folder.path}>
+                <div className="min-w-0 break-all text-sm">
+                  <div>{folder.path}</div>
+                  {folder.is_primary && <span>{copy.primary}</span>}
+                </div>
+                <Button aria-label={copy.removePath(folder.path)} disabled={pending} onClick={() => void remove(folder.path)} type="button" variant="outline">
+                  {copy.remove}
+                </Button>
+              </li>
+            ))}
+          </ul>
+        ) : <p className="text-sm">{copy.empty}</p>)}
+        <DialogFooter><Button disabled={pending} onClick={onClose} type="button" variant="ghost">{t.common.done}</Button></DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
