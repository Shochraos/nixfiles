+export interface ProjectFolderRecord {
+  path: string
+  is_primary: boolean
+}
+
+export interface ProjectFolderProject {
+  id: string
+  primary_path?: null | string
+  folders: ProjectFolderRecord[]
+}
+
+export interface ProjectFolderOwner {
+  connectionId: null | string
+  profile: string
+  projectId: string
+}
+
+export type ProjectFolderRequest = <T>(
+  owner: ProjectFolderOwner,
+  method: string,
+  params: Record<string, unknown>
+) => Promise<T>
+
+export class ProjectFolderError extends Error {
+  readonly reason: 'invalidResponse' | 'missingAttachment' | 'stillAttached'
+
+  constructor(reason: ProjectFolderError['reason']) {
+    super(reason)
+    this.reason = reason
+  }
+}
+
+export async function loadProjectFolders(
+  owner: ProjectFolderOwner,
+  request: ProjectFolderRequest
+): Promise<ProjectFolderProject> {
+  const result = await request<{ project: ProjectFolderProject | null }>(owner, 'projects.get', {
+    id: owner.projectId,
+    profile: owner.profile
+  })
+
+  if (!result?.project || result.project.id !== owner.projectId || !Array.isArray(result.project.folders)) {
+    throw new ProjectFolderError('invalidResponse')
+  }
+
+  return result.project
+}
+
+export async function removeProjectFolder(
+  owner: ProjectFolderOwner,
+  project: ProjectFolderProject,
+  path: string,
+  request: ProjectFolderRequest
+): Promise<ProjectFolderProject> {
+  if (project.id !== owner.projectId || !project.folders.some(folder => folder.path === path)) {
+    throw new ProjectFolderError('missingAttachment')
+  }
+
+  const result = await request<{ project: ProjectFolderProject | null }>(owner, 'projects.remove_folder', {
+    id: owner.projectId,
+    path,
+    profile: owner.profile
+  })
+
+  if (!result?.project || result.project.id !== owner.projectId || !Array.isArray(result.project.folders)) {
+    throw new ProjectFolderError('invalidResponse')
+  }
+
+  if (result.project.folders.some(folder => folder.path === path)) {
+    throw new ProjectFolderError('stillAttached')
+  }
+
+  return result.project
+}
